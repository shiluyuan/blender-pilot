# Generate a private .env with ./docker-up.sh (do not copy these placeholders).
PILOT_PASSWORD=replace-with-at-least-12-characters
PILOT_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
PILOT_BIND=0.0.0.0
PILOT_PORT=8090
PILOT_SECURE_COOKIE=false
PILOT_RESOLUTION=1440x900x24
PILOT_MAX_STUDIOS=3
PILOT_GPU=false
PILOT_DATA_DIR=./data
PILOT_POSTGRES_DIR=./postgres-data
PILOT_BUNDLED_DB=true
POSTGRES_IMAGE=postgres:18.6-bookworm
POSTGRES_USER=blender_pilot
POSTGRES_DB=blender_pilot
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgresql://blender_pilot:replace-with-random-password@db:5432/blender_pilot
# Resolved and SHA256-verified from Blender's official release directory.
BLENDER_VERSION=5.2.3
BLENDER_SHA256=78486c018b4443efe5e75ab54c290ed8c15abafd249b862c2c9ce2530a918eec
# Model credentials are configured in the web UI or --api-key-file bootstrap.
