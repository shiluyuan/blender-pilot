# ./scripts/setup.sh generates these two secrets. Do not commit .env.
PILOT_PASSWORD=replace-with-a-long-random-password
PILOT_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
PILOT_BIND=127.0.0.1
PILOT_PORT=8090
# Set true when serving through HTTPS. Keep false for localhost / SSH forwarding.
PILOT_SECURE_COOKIE=false
PILOT_RESOLUTION=1440x900x24
# API Key, Base URL and model are configured in the web Settings screen.

# Independent Blender instances; close an idle project to release RAM.
PILOT_MAX_STUDIOS=3
